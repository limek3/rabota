{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // vexa-dashboard-v30 — снимок старой версии приложения со своим package.json и
  // своим tsconfig. Корневой include ("**/*.tsx") затягивал его сюда, а его
  // "@/..." резолвились по корневым paths — то есть старый код собирался против
  // нового lib. Проверять его должен его собственный tsconfig, а не этот.
  // supabase — SQL-миграции и архив Deno edge functions Vexa (Deno.*, esm.sh
  // импорты). Их типизирует Deno, а не этот tsconfig на Next.
  "exclude": ["node_modules", "vexa-dashboard-v30", "supabase"]
}
