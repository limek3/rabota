node_modules
.next
out

# собранные установщики — это артефакты сборки, им место в релизах, а не в git
dist
.DS_Store
*.log
.env*.local
env.local
# резервные копии env: шаблон выше их не ловит (имя не заканчивается на
# .local), а внутри те же ключи — в репозитории им не место
.env.local.*

# кеш инкрементальной сборки TS — машинный, у каждого свой
tsconfig.tsbuildinfo

# архивы: в git они не сжимаются и остаются в истории навсегда,
# даже если удалить файл следующим коммитом
*.zip
# base64-дамп архива — то же самое, только ещё и текстом
*_b64.txt

# личные настройки Claude Code; .claude/launch.json при этом коммитим —
# он общий и описывает, как поднять dev-сервер
.claude/settings.local.json

# сборка тестов расчётов (npm run test:calc)
.calc-test
